# Copy this file to .env locally and insert your own key.
# In Hugging Face Spaces, set GROQ_API_KEY as a Secret instead.
GROQ_API_KEY=replace_with_your_own_key
GROQ_MODEL=openai/gpt-oss-20b
# Set to the vision model ID confirmed to work in your Groq account.
GROQ_VISION_MODEL=replace_with_your_working_vision_model
